rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Friendship is MUTUAL, and each side writes only its OWN friendIds. A reads B's
    // private recipe only if B is in A's list AND A is in B's list. No one can write
    // another user's friendIds, so neither side can force the other into a friendship
    // (the old "add myself to their list" rule let anyone wipe or stuff a friend list).
    function friendsOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('friendIds', []);
    }
    function mutualFriendOf(authorId) {
      return authorId in friendsOf(request.auth.uid) && request.auth.uid in friendsOf(authorId);
    }

    // Users can read any profile (needed for friend search) but only edit their own.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, delete: if isSelf(userId);
      allow update: if isSelf(userId);

      // Private to the owner: holds the secret that makes their invite link work.
      match /private/{docId} {
        allow read, write: if isSelf(userId);
      }

      // Grocery list is private to its owner.
      match /grocery/{itemId} {
        allow read, write: if isSelf(userId);
      }
    }

    // Recipes: public ones readable by all signed-in users; private ones
    // readable by the author and that author's friends. Only the author writes.
    match /recipes/{recipeId} {
      allow read: if signedIn() && (
        resource.data.isPublic == true ||
        resource.data.authorId == request.auth.uid ||
        mutualFriendOf(resource.data.authorId)
      );
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Friend requests: sender creates; only the recipient can accept/decline; either
    // party can delete (unfriending clears the record so it can't re-add anyone).
    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      // A request is born 'pending' (the recipient must accept) — OR born 'accepted' when
      // it carries the recipient's secret invite token, i.e. the sender opened the
      // recipient's own invite link. Nobody can forge an accepted request without the token.
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid && (
        request.resource.data.status == 'pending' ||
        (request.resource.data.status == 'accepted' &&
         request.resource.data.get('inviteToken', null) != null &&
         request.resource.data.inviteToken ==
           get(/databases/$(database)/documents/users/$(request.resource.data.toUserId)/private/invite).data.get('token', null))
      );
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow delete: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
    }
  }
}
