rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function myFriends() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friendIds;
    }

    // Users can read any profile (needed for friend search) but only edit their own.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isSelf(userId);

      // Grocery list is private to its owner.
      match /grocery/{itemId} {
        allow read, write: if isSelf(userId);
      }
    }

    // Recipes: public ones readable by all signed-in users; private ones
    // readable by the author and that author's friends. Only the author writes.
    match /recipes/{recipeId} {
      allow read: if signedIn() && (
        resource.data.isPublic == true ||
        resource.data.authorId == request.auth.uid ||
        resource.data.authorId in myFriends()
      );
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Friend requests: sender creates; only the recipient can accept/decline.
    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid;
    }
  }
}
