rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function myFriends() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friendIds;
    }
    // Allow a signed-in user to add or remove (only) themselves in another user's
    // friend list, touching no other field. Powers friend-invite links, mutual
    // accept of friend requests, and mutual unfriend.
    //
    // The set comparison is load-bearing. The old rule only asked "is the caller in
    // the NEW array", which a plain assignment of [attackerUid] also satisfies — so
    // any signed-in user could WIPE anyone's entire friend list, or insert a third
    // party into it. Comparing sets pins the change to exactly one element: the
    // caller's own uid, added or removed, with every other entry preserved.
    function friendsPlusSelf() {
      return resource.data.get('friendIds', []).toSet().union([request.auth.uid].toSet());
    }
    function friendsMinusSelf() {
      return resource.data.get('friendIds', []).toSet().difference([request.auth.uid].toSet());
    }
    function togglesSelfInFriends() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds'])
        && (request.resource.data.friendIds.toSet() == friendsPlusSelf()
            || request.resource.data.friendIds.toSet() == friendsMinusSelf());
    }

    // Users can read any profile (needed for friend search) but only edit their
    // own — except the constrained friendIds self-add above.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, delete: if isSelf(userId);
      allow update: if isSelf(userId) || togglesSelfInFriends();

      // Grocery list is private to its owner.
      match /grocery/{itemId} {
        allow read, write: if isSelf(userId);
      }
    }

    // Recipes: public ones readable by all signed-in users; private ones
    // readable by the author and that author's friends. Only the author writes.
    match /recipes/{recipeId} {
      allow read: if signedIn() && (
        resource.data.isPublic == true ||
        resource.data.authorId == request.auth.uid ||
        resource.data.authorId in myFriends()
      );
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Friend requests: sender creates; only the recipient can accept/decline.
    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid;
    }
  }
}
