# Copy to .env and fill in your own values.

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Anthropic (Claude) — SERVER-SIDE ONLY ---
# No VITE_ prefix → never bundled into the browser. Read by api/parse.js and the
# local dev middleware. In production set this in the Vercel dashboard.
ANTHROPIC_API_KEY=
